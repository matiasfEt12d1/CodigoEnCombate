<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Prueba de concepto de Indagación (Actividad 1). Independiente de src/Proyecto.sln. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- configuracion/ es otro proyecto (Actividad 3): no se compila acá. -->
