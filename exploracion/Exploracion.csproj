    <Compile Remove="configuracion/**" />
    <Content Remove="configuracion/**" />
    <None Remove="configuracion/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

</Project>
